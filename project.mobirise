          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features01 soundm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Tags\" name=\"showTags\" checked>\n        <input type=\"color\" title=\"Tags BG\" value=\"#FFF5E8\" name=\"tagsBg\" condition=\"showTags\" selected>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#2EC4B6\" name=\"border\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showCardButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#eeeef7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-6\" mbr-if=\"showTags || showText\">\n                <div class=\"content-wrapper\">\n                    <div class=\"tags-wrapper\" mbr-if=\"showTags\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\">AI</li>\n                            <li class=\"item-wrap\">Innovazione</li>\n                            <li class=\"item-wrap\">Eccellenza</li>\n                        </ul>\n                    </div>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">I nostri agenti sono progettati per eccellere in ogni interazione. Scopri come possono trasformare il tuo business!</p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\" mbr-if=\"showButtons\">\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"index.html#contact-form-1-uBp6ZFnDvo\" data-app-placeholder=\"Type Text\">Inizia Ora</a></div>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"items-wrap\">\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Finanza</h4>\n                            <div class=\"item-img\">\n                                <img src=\"https://r.mobirisesite.com/1153980/assets/images/photo-1483478550801-ceba5fe50e8e.jpeg\" alt=\"Mobirise Website Builder\">\n                            </div>\n                            <div class=\"item-content\">\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Gestiamo il tuo agente empatico con precisione e competenza. Non lasciamo nulla al caso!</p>\n                                <div class=\"mbr-section-btn items-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-success\" data-app-placeholder=\"Type Text\">Scopri</a></div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Assicurazioni</h4>\n                            <div class=\"item-img\">\n                                <img src=\"https://r.mobirisesite.com/1153980/assets/images/photo-1597733336794-12d05021d510.jpeg\" alt=\"Mobirise Website Builder\">\n                            </div>\n                            <div class=\"item-content\">\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Le nostre soluzioni di intelligenza artificiale per le assicurazioni sono rapide e affidabili.&nbsp;</p>\n                                <div class=\"mbr-section-btn items-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\">\n                                    <a href class=\"btn item-btn btn-success\" data-app-placeholder=\"Type Text\">Scopri</a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Medici</h4>\n                            <div class=\"item-img\">\n                                <img src=\"https://r.mobirisesite.com/1153980/assets/images/photo-1487058792275-0ad4aaf24ca7.jpeg\" alt=\"Mobirise Website Builder\">\n                            </div>\n                            <div class=\"item-content\">\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Supportiamo i professionisti medici con le nostre IA di assistenza clienti impeccabili. La salute (anche quella del medico) è la priorità!</p>\n                                <div class=\"mbr-section-btn items-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\">\n                                    <a href class=\"btn item-btn btn-success\" data-app-placeholder=\"Type Text\">Scopri</a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Immobiliare</h4>\n                            <div class=\"item-img\">\n                                <img src=\"https://r.mobirisesite.com/1153980/assets/images/photo-1485579149621-3123dd979885.jpeg\" alt=\"Mobirise Website Builder\">\n                            </div>\n                            <div class=\"item-content\">\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Le nostre AI aiutano le agenzie immobiliari a chiudere affari in un batter d'occhio!</p>\n                                <div class=\"mbr-section-btn items-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-success\" data-app-placeholder=\"Type Text\">Scopri</a></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_name": "features01",
          "_sourceTheme": "soundm5",
          "_cid": "uBp6ZFiOfB",
          "_anchor": "features-1-uBp6ZFiOfB",
          "alias": false,
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "if(@transparentBg, transparent, @bg-value)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".items-wrap": {
              "justify-content": "center"
            },
            ".tab-content": {
              ".tab-pane": {
                ".item-content": {
                  "padding": "48px",
                  "background-color": "@card",
                  "@media (max-width: 992px)": {
                    "padding": "26px 22px"
                  },
                  ".image-wrapper": {
                    "position": "relative",
                    "margin-bottom": "32px",
                    ".image-wrap": {
                      "display": "flex",
                      "justify-content": "center",
                      "img": {
                        "width": "450px",
                        "height": "450px",
                        "object-fit": "cover",
                        "border-radius": "100% !important",
                        "@media (max-width: 1440px)": {
                          "height": "350px",
                          "width": "350px"
                        },
                        "@media (max-width: 1200px)": {
                          "height": "300px",
                          "width": "300px"
                        },
                        "@media (max-width: 768px)": {
                          "height": "225px",
                          "width": "225px"
                        }
                      }
                    },
                    ".number-wrapper": {
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "z-index": "1",
                      ".item-number": {
                        "display": "inline-flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "width": "88px",
                        "height": "88px",
                        "border-radius": "100%",
                        "background-color": "@number",
                        "margin-bottom": "0"
                      }
                    }
                  },
                  ".text-wrapper": {
                    ".item-title": {
                      "margin-bottom": "10px"
                    },
                    ".item-text": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".tabs-wrapper": {
              "padding-top": "48px",
              "@media (max-width: 992px)": {
                "padding-top": "0",
                "text-align": "center"
              },
              ".nav.nav-tabs": {
                "border": "none",
                "padding": "0",
                "background-color": "transparent",
                "display": "inline-flex",
                "flex-direction": "column",
                "justify-content": "center",
                "align-items": "flex-end",
                "flex-wrap": "wrap",
                "& when not (@reverseContent)": {
                  "align-items": "flex-start"
                },
                "@media (max-width: 992px)": {
                  "align-items": "center !important"
                },
                ".nav-item": {
                  "padding": "0",
                  "border": "none",
                  "display": "inline-block",
                  "width": "fit-content",
                  "margin": "0 8px 16px",
                  ".nav-link": {
                    "border": "1px solid @border",
                    "background-color": "@tabsBg",
                    "color": "@tabs",
                    "padding": "10px 32px",
                    "transition": "all 0.3s ease-in-out"
                  },
                  ".nav-link.active": {
                    "background-color": "@active",
                    "border": "1px solid @active",
                    "color": "@activeColor"
                  }
                }
              },
              "text-align": "right"
            },
            ".card": {
              "justify-content": "space-between"
            },
            ".mbr-section-btn": {
              "margin-bottom": "22px",
              ".btn": {
                "margin-bottom": "0"
              },
              "text-align": "right",
              "@media (max-width: 992px)": {
                "text-align": "center"
              }
            },
            ".item-number": {
              "color": "#191c25"
            },
            ".item-title": {
              "color": "#191c25",
              "text-align": "center"
            },
            ".item-text": {
              "color": "#000000",
              "text-align": "center"
            },
            ".item-number, .number-wrapper": {
              "color": "#000000"
            },
            ".item-title, .tabs-wrapper, .mbr-section-btn": {
              "color": "#000000"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs tabs02 soundm5\" group=\"List\" plugins=\"mbr-tabs\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n        </select>\n        <input type=\"color\" title=\"Tabs Color\" value=\"#000000\" name=\"tabs\" selected>\n        <input type=\"color\" title=\"Tabs BG\" value=\"#FFF5E8\" name=\"tabsBg\" selected>\n        <input type=\"color\" title=\"Tabs Border Color\" value=\"#2EC4B6\" name=\"border\" selected>\n        <input type=\"color\" title=\"Tabs Active BG\" value=\"#FF9F1C\" name=\"active\" selected>\n        <input type=\"color\" title=\"Tabs Active Color\" value=\"#000000\" name=\"activeColor\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Number\" name=\"showNumber\" checked>\n        <input type=\"color\" title=\"Number BG\" value=\"#2EC4B6\" name=\"number\" condition=\"showNumber\" selected>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Card BG\" value=\"#FF9F1C\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#eeeef7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row items-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-4 card\">\n                <div class=\"tabs-wrapper\">\n                    <ul class=\"nav nav-tabs\" role=\"tablist\">\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item first mbr-fonts-style\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link show mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-5-uBp6ZFjnm1_tab0\" aria-selected=\"true\">Supporto</a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-5-uBp6ZFjnm1_tab1\" aria-selected=\"false\">Vendite</a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-5-uBp6ZFjnm1_tab2\" aria-selected=\"false\">Lead</a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-5-uBp6ZFjnm1_tab3\" aria-selected=\"true\">Settori</a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 4\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-5-uBp6ZFjnm1_tab4\" aria-selected=\"true\">Innovazione</a></li>\n                    </ul>\n                </div>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Scopri di più</a></div>\n            </div>\n            <div class=\"col-12 col-lg-5\">\n                <div class=\"tab-content\">\n                    <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                        <div class=\"item-content\">\n                            <div class=\"image-wrapper\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/photo-1496171367470-9ed9a91ea931.png\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"number-wrapper\">\n                                    <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showNumber\" data-app-selector=\".item-number, .number-wrapper\">\n                                        <b>01</b>\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .tabs-wrapper, .mbr-section-btn\">Supporto</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\" mbr-if=\"showText\">Il nostro supporto è sempre disponibile. Non ti lasceremo mai solo, nemmeno in un sabato sera!</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                        <div class=\"item-content\">\n                            <div class=\"image-wrapper\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/photo-1526666923127-b2970f64b422.jpeg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"number-wrapper\">\n                                    <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showNumber\" data-app-selector=\".item-number, .number-wrapper\">\n                                        <b>02</b>\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .tabs-wrapper, .mbr-section-btn\">Vendite</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\" mbr-if=\"showText\">Le vendite non sono mai state così facili. I nostri agenti chiudono affari come se fossero in un film!</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                        <div class=\"item-content\">\n                            <div class=\"image-wrapper\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/photo-1496065187959-7f07b8353c55.jpeg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"number-wrapper\">\n                                    <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showNumber\" data-app-selector=\".item-number, .number-wrapper\">\n                                        <b>03</b>\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .tabs-wrapper, .mbr-section-btn\">Lead</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\" mbr-if=\"showText\">Generiamo lead come se piovessero. Non importa se sono freddi o caldi, li facciamo brillare!</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                        <div class=\"item-content\">\n                            <div class=\"image-wrapper\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/photo-1649972904349-6e44c42644a7.jpeg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"number-wrapper\">\n                                    <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showNumber\" data-app-selector=\".item-number, .number-wrapper\">\n                                        <b>04</b>\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .tabs-wrapper, .mbr-section-btn\">Settori</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\" mbr-if=\"showText\">Operiamo in vari settori, dalla finanza all'immobiliare. Siamo ovunque tu abbia bisogno di noi!</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab5\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 4\">\n                        <div class=\"item-content\">\n                            <div class=\"image-wrapper\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/photo-1483478550801-ceba5fe50e8e.jpeg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"number-wrapper\">\n                                    <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showNumber\" data-app-selector=\".item-number, .number-wrapper\">\n                                        <b>05</b>\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .tabs-wrapper, .mbr-section-btn\">Innovazione</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\" mbr-if=\"showText\">Innoviamo costantemente. I nostri agenti sono sempre aggiornati e pronti a stupirti!</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
