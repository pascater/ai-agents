                "padding": "26px 22px",
                "margin-bottom": "12px",
                "height": "auto"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              }
            },
            ".card-wrapper": {
              "padding": "96px",
              "background-color": "@contactsBg",
              "margin-top": "32px",
              "@media (max-width: 1440px)": {
                "padding": "48px"
              },
              "@media (max-width: 992px)": {
                "padding": "26px 22px",
                "margin-top": "12px"
              },
              "&:first-child": {
                "margin-top": "0"
              },
              ".mbr-address, .mbr-phone, .mbr-email": {
                "margin-bottom": "0"
              }
            },
            ".mbr-section-title": {
              "color": "#191c25"
            },
            ".mbr-address": {
