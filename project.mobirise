        {
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "position": "relative",
            ".image-wrap": {
              "img": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "object-fit": "cover",
                "width": "100%",
                "height": "100%",
                "padding": "12px",
                "@media (max-width: 992px)": {
                  "padding": "12px 0"
                }
              }
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "if(@transparentBg, transparent, @bg-value)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".content-wrap": {
                "padding-left": "12px !important",
                "padding-right": "12px !important"
              }
            },
            ".content-wrapper": {
              "position": "relative",
              "z-index": "1",
              "padding": "96px",
              "border": "3px solid @border",
              "overflow": "hidden",
              "margin-right": "36px",
              "@media (max-width: 1440px)": {
                "padding": "48px",
                "margin-right": "22px"
              },
              "@media (max-width: 992px)": {
                "padding": "26px 22px",
                "margin": "0"
              },
              "& when not (@reverseContent)": {
                "margin-right": "0",
                "margin-left": "36px",
                "@media (max-width: 1440px)": {
                  "margin-left": "22px"
                },
                "@media (max-width: 992px)": {
                  "margin": "0"
                }
              },
              "&::before": {
                "content": "''",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background-color": "@card",
                "opacity": "@cardOpacity",
                "pointer-events": "none"
              },
              ".mbr-section-title": {
                "position": "relative",
                "z-index": "2",
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "position": "relative",
                "z-index": "2",
                "margin-bottom": "22px",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              },
              ".mbr-section-btn": {
                "position": "relative",
                "z-index": "2",
                ".btn": {
                  "margin-bottom": "0"
                }
              },
              ".social-wrapper": {
                "position": "relative",
                "z-index": "2",
                "margin-bottom": "22px",
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  "justify-content": "flex-end",
                  ".soc-item": {
                    "display": "inline-flex",
                    "align-items": "center",
                    "justify-content": "center",
                    "width": "68px",
                    "height": "68px",
                    "border": "1px solid @socBorder",
                    "border-radius": "100%",
                    "margin": "12px 0 0 12px",
                    "a": {
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "background-color": "@activeBg",
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "display": "flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "width": "48px",
                        "height": "48px",
                        "min-width": "48px",
                        "color": "@socColor",
                        "background-color": "@socBg",
                        "font-size": "22px",
                        "border-radius": "100%",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#191c25"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#191c25",
              "text-align": "right"
            },
            ".mbr-section-title, .mbr-section-btn, .social-wrapper": {
              "text-align": "right",
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#000000"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header01 soundm5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Card Border Color\" value=\"#2EC4B6\" name=\"border\" selected>\n        <input type=\"color\" title=\"Card Bg\" value=\"#FF9F1C\" name=\"card\" selected>\n\t\t<input type=\"range\" inline title=\"Card Opacity\" name=\"cardOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\">\n        <input type=\"checkbox\" title=\"Image Bg\" name=\"showImage\" checked>\n\t\t<input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n\t\t<input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"4\" condition=\"showSocial\">\n\t\t<input type=\"color\" title=\"Social Color\" value=\"#000000\" name=\"socColor\" condition=\"showSocial\" selected> \n\t\t<input type=\"color\" title=\"Social BG\" value=\"#2EC4B6\" name=\"socBg\" condition=\"showSocial\" selected>\n\t\t<input type=\"color\" title=\"Social Border Color\" value=\"#000000\" name=\"socBorder\" condition=\"showSocial\" selected>\n\t\t<input type=\"color\" title=\"Social Active Color\" value=\"#2EC4B6\" name=\"active\" condition=\"showSocial\" selected>\n\t\t<input type=\"color\" title=\"Social Active BG\" value=\"#000000\" name=\"activeBg\" condition=\"showSocial\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#eeeef7\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"content-wrap\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-7\">\n                <div class=\"content-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn, .social-wrapper\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">Agenti Empatici</h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Rivoluziona il tuo customer care e le vendite con i nostri agenti AI avanzati!</p>\n\t\t\t\t\t<div class=\"social-wrapper\" mbr-if=\"showSocial\">\n\t\t\t\t\t\t<div class=\"social-wrap\">\n\t\t\t\t\t\t\t<div class=\"soc-item\">\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont socicon-telegram socicon\"></span>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"soc > 1\">\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\"></span>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"soc > 2\">\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont socicon-spotify socicon\"></span>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"soc > 3\">\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont socicon-youtube socicon\"></span>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" data-app-placeholder=\"Type Text\" href=\"index.html#contact-form-1-uBp6ZFnDvo\">Inizia ora</a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"image-wrap\" mbr-if=\"showImage\">\n        <img src=\"@PROJECT_PATH@/assets/images/photo-1483478550801-ceba5fe50e8e.jpeg\" alt=\"Mobirise\">\n    </div>\n</section>",
