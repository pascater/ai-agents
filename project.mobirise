                      "position": "relative",
                      "z-index": "1",
                      "padding": "21px 32px",
                      "border": "1px solid @border !important",
                      "background-color": "@inputBg",
                      "&:hover, &:focus": {
                        "border": "1px solid @border !important"
                      },
                      "&::placeholder": {
                        "color": "@inputColor"
                      }
                    },
                    "textarea": {
                      "min-height": "150px"
                    },
                    ".form-check": {
                      "padding-left": "2.3em",
                      "margin-bottom": "16px",
                      ".form-check-input": {
                        "background-color": "@inputColor",
                        "border-color": "@inputColor"
                      }
                    }
                  },
                  ".mbr-section-btn": {
                    "width": "100%",
                    ".btn": {
                      "padding": "15px 12px",
                      "width": "100%",
                      "margin-bottom": "0",
                      "@media (max-width: 992px)": {
                        "margin-left": "10px"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#191c25"
            },
            ".mbr-text": {
              "color": "#000000"
