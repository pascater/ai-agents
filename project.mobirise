        {
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "if(@transparentBg, transparent, @bg-value)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".items-wrap": {
              "justify-content": "space-between"
            },
            ".content-wrapper": {
              "padding": "96px",
              "background-color": "@container",
              "@media (max-width: 1440px)": {
                "padding": "48px"
              },
              "@media (max-width: 992px)": {
                "padding": "26px 22px 22px"
              },
              ".title-wrapper": {
                "margin-bottom": "60px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "32px"
                },
                ".title-wrap": {
                  "display": "inline-flex",
                  "align-items": "center",
                  "@media (max-width: 992px)": {
                    "display": "block"
                  },
                  ".logo-wrap": {
                    "img": {
                      "width": "86px",
                      "height": "86px",
                      "border-radius": "100% !important",
                      "object-fit": "cover"
                    },
                    "& when (@showTitle)": {
                      "margin-right": "68px",
                      "@media (max-width: 1440px)": {
                        "margin-right": "32px"
                      },
                      "@media (max-width: 992px)": {
                        "margin-right": "0",
                        "margin-bottom": "22px"
                      }
                    }
                  },
                  ".mbr-section-title": {
                    "margin-bottom": "0"
                  }
                }
              },
              ".tabs-wrapper": {
                "margin-bottom": "60px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "32px"
                },
                ".nav.nav-tabs": {
                  "border": "none",
                  "padding": "0",
                  "background-color": "transparent",
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".nav-item": {
                    "padding": "0",
                    "border": "none",
                    "display": "block",
                    "margin": "0 12px 12px 0",
                    ".nav-link": {
                      "color": "@tabs",
                      "padding": "11px 32px",
                      "border": "none",
                      "background-color": "@tabsBg",
                      "transition": "all 0.3s ease-in-out"
                    },
                    ".nav-link.active": {
                      "background-color": "@tabs",
                      "color": "@tabsBg"
                    }
                  }
                }
              },
              ".tab-content": {
                ".tab-pane": {
                  ".item-content": {
                    "display": "flex",
                    "@media (max-width: 992px)": {
                      "display": "block"
                    },
                    ".list-wrapper": {
                      "width": "50%",
                      "padding-right": "60px",
                      "@media (max-width: 992px)": {
                        "padding-right": "0",
                        "width": "100%"
                      },
                      "& when (@reverseContent)": {
                        "padding-right": "0",
                        "padding-left": "60px",
                        "@media (max-width: 992px)": {
                          "padding-left": "0",
                          "width": "100%"
                        }
                      },
                      ".list": {
                        "margin-bottom": "32px",
                        ".item-wrap": {
                          "margin-bottom": "22px",
                          "&:last-child": {
                            "margin-bottom": "0"
                          },
                          "&::marker": {
                            "font-weight": "700"
                          }
                        }
                      }
                    },
                    ".image-wrap": {
                      "width": "50%",
                      "display": "flex",
                      "@media (max-width: 992px)": {
                        "width": "100%",
                        "margin-bottom": "32px"
                      },
                      "img": {
                        "height": "650px",
                        "width": "100%",
                        "object-fit": "cover",
                        "@media (max-width: 992px)": {
                          "height": "350px"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".list": {
              "color": "#191c25"
            },
            ".list, .item-wrap": {
              "color": "#000000"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs tabs03 soundm5\" group=\"List\" plugins=\"mbr-tabs\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#2EC4B6\" name=\"container\" selected>\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n        </select>\n        <input type=\"color\" title=\"Tabs Color\" value=\"#000000\" name=\"tabs\" selected>\n        <input type=\"color\" title=\"Tabs BG\" value=\"#FFF5E8\" name=\"tabsBg\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card List\" name=\"showList\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#eeeef7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n                            <div class=\"logo-wrap\" mbr-if=\"showLogo\">\n                                <img src=\"https://r.mobirisesite.com/1153980/assets/images/photo-1496096265110-f83ad7f96608.jpeg\" alt=\"Mobirise\">\n                            </div>\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">I nostri Agenti</h2>\n                        </div>\n                    </div>\n                    <div class=\"tabs-wrapper\">\n                        <ul class=\"nav nav-tabs\" role=\"tablist\">\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item first mbr-fonts-style\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link show mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-6-uBp6ZFcge7_tab0\" aria-selected=\"false\">Inbound</a></li>\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-6-uBp6ZFcge7_tab1\" aria-selected=\"true\">Outbound</a></li>\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-6-uBp6ZFcge7_tab2\" aria-selected=\"true\">Settori</a></li>\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-6-uBp6ZFcge7_tab3\" aria-selected=\"true\">Tecnologia</a></li>\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 4\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-6-uBp6ZFcge7_tab4\" aria-selected=\"true\">Vantaggi</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"tab-content\">\n                        <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                            <div class=\"item-content\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"list-wrapper\" mbr-if=\"showList\">\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\">Assistenza clienti sempre disponibile e reattiva.</li>\n                                        <li class=\"item-wrap\">Gestione agenda senza stress e confusione.</li>\n                                        <li class=\"item-wrap\">Risposte rapide e precise per ogni richiesta.</li>\n                                        <li class=\"item-wrap\">Riduzione dei tempi di attesa per i clienti.</li>\n                                    </ul>\n                                </div>\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/photo-1550751827-4bd374c3f58b.jpeg\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                            <div class=\"item-content\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"list-wrapper\" mbr-if=\"showList\">\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\">Chiamate di vendita che fanno la differenza.</li>\n                                        <li class=\"item-wrap\">Lead generation su misura per il tuo business.</li>\n                                        <li class=\"item-wrap\">Contatti con clienti già esistenti e nuovi.</li>\n                                        <li class=\"item-wrap\">Strategie vincenti per ogni settore.</li>\n                                        <li class=\"item-wrap\">Aumento delle vendite e della soddisfazione.</li>\n                                    </ul>\n                                </div>\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/photo-1526374965328-7f61d4dc18c5.jpeg\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                            <div class=\"item-content\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"list-wrapper\" mbr-if=\"showList\">\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\">Finanza: soluzioni intelligenti per i tuoi clienti.</li>\n                                        <li class=\"item-wrap\">Assicurazioni: assistenza rapida e precisa.</li>\n                                        <li class=\"item-wrap\">Settore medico: supporto per pazienti e dottori.</li>\n                                        <li class=\"item-wrap\">Agenzie immobiliari: vendite facilitate e rapide.</li>\n                                        <li class=\"item-wrap\">Liberi professionisti: gestione del tempo ottimale.</li>\n                                    </ul>\n                                </div>\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/photo-1597733336794-12d05021d510.jpeg\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                            <div class=\"item-content\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"list-wrapper\" mbr-if=\"showList\">\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\">Modelli LLM avanzati per prestazioni superiori.</li>\n                                        <li class=\"item-wrap\">Prompt specifici per ogni settore.</li>\n                                        <li class=\"item-wrap\">Knowledge base ampia e dettagliata.</li>\n                                        <li class=\"item-wrap\">Tecnologia all'avanguardia per risultati eccellenti.</li>\n                                        <li class=\"item-wrap\">Innovazione continua per rimanere competitivi.</li>\n                                    </ul>\n                                </div>\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/photo-1568952433726-3896e3881c65.jpeg\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab5\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 4\">\n                            <div class=\"item-content\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"list-wrapper\" mbr-if=\"showList\">\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\">Risparmio di tempo e risorse per le aziende.</li>\n                                        <li class=\"item-wrap\">Miglioramento dell'esperienza cliente.</li>\n                                        <li class=\"item-wrap\">Aumento della produttività e delle vendite.</li>\n                                        <li class=\"item-wrap\">Semplicità d'uso per tutti gli utenti.</li>\n                                        <li class=\"item-wrap\">Supporto costante e aggiornamenti regolari.</li>\n                                    </ul>\n                                </div>\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/photo-1518770660439-4636190af475.jpeg\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_name": "tabs03",
          "_sourceTheme": "soundm5",
          "_cid": "uBp6ZFcge7",
          "_anchor": "features-6-uBp6ZFcge7",
          "alias": false,
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "if(@transparentBg, transparent, @bg-value)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".panel-group": {
              ".card": {
                "position": "relative",
                "padding": "60px 0",
                "border": "none",
                "margin-top": "0",
                "border-top": "2px solid @border",
                "border-radius": "0 !important",
                "@media (max-width: 992px)": {
                  "padding": "32px 0"
                },
                ".card-header": {
                  "background-color": "transparent",
                  "border": "none",
                  "padding": "0",
                  ".panel-title": {
                    "display": "flex",
                    "align-items": "center",
                    "justify-content": "space-between",
                    "@media (max-width: 992px)": {
                      "display": "block"
                    },
                    ".panel-title-edit": {
                      "width": "50%",
                      "margin-bottom": "0",
                      "padding-right": "60px",
                      "@media (max-width: 1440px)": {
                        "padding-right": "32px"
                      },
                      "@media (max-width: 992px)": {
                        "width": "100%",
                        "margin-bottom": "22px",
                        "padding-right": "0"
                      },
                      "& when not (@showDesc)": {
                        "width": "100%"
                      }
                    },
                    ".desc-wrapper": {
                      "width": "35%",
                      "@media (max-width: 992px)": {
                        "width": "100%"
                      },
                      ".panel-desc": {
                        "margin-bottom": "0",
                        "@media (max-width: 992px)": {
                          "margin-bottom": "22px"
                        }
                      }
                    },
                    ".icon-wrapper": {
                      "width": "15%",
                      "padding-left": "32px",
                      "text-align": "right",
                      "@media (max-width: 992px)": {
                        "width": "100%",
                        "text-align": "center",
                        "padding-left": "0"
                      },
                      ".icon-wrap": {
                        "display": "inline-flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "width": "68px",
                        "height": "68px",
                        "border": "1px solid @border",
                        "border-radius": "100%",
                        ".mbr-iconfont": {
                          "display": "flex",
                          "align-items": "center",
                          "justify-content": "center",
                          "width": "48px",
                          "height": "48px",
                          "min-width": "48px",
                          "color": "@icon",
                          "background-color": "@iconBg",
                          "font-size": "16px",
                          "border-radius": "100%",
                          "transition": "all 0.3s ease-in-out"
                        }
                      }
                    },
                    "&:not(.collapsed)": {
                      ".icon-wrapper": {
                        ".icon-wrap": {
                          ".mbr-iconfont": {
                            "transform": "rotate(-45deg)"
                          }
                        }
                      }
                    }
                  }
                },
                ".panel-collapse": {
                  ".panel-body": {
                    "display": "flex",
                    "justify-content": "flex-end",
                    "margin-top": "60px",
                    "@media (max-width: 992px)": {
                      "margin-top": "32px"
                    },
                    ".panel-text": {
                      "display": "inline-block",
                      "width": "50%",
                      "margin-bottom": "0",
                      "padding-right": "15%",
                      "@media (max-width: 992px)": {
                        "width": "100%"
                      }
                    }
                  }
                }
              }
            },
            ".panel-title-edit": {
              "color": "#191c25"
            },
            ".panel-desc": {
              "color": "#000000"
            },
            ".panel-text": {
              "color": "#191c25"
            },
            ".panel-title-edit, .icon-wrapper": {
              "color": "#000000"
            },
            ".panel-text, .panel-body": {
              "color": "#000000"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list02 soundm5\" group=\"List\" plugins=\"mbr-switch-arrow, mobirise-icons2\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>List</header>\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#000000\" name=\"border\" selected>\n        <input type=\"color\" title=\"Icon Color\" value=\"#000000\" name=\"icon\" selected>\n        <input type=\"color\" title=\"Icon Bg\" value=\"#FF9F1C\" name=\"iconBg\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#eeeef7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                    <div class=\"card\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .icon-wrapper\">Cosa sono gli agenti conversazionali?</h4>\n                                <div class=\"desc-wrapper\" mbr-if=\"showDesc\">\n                                    <p class=\"panel-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-desc\">Scopri come funzionano i nostri agenti.</p>\n                                </div>\n                                <div class=\"icon-wrapper\">\n                                    <div class=\"icon-wrap\">\n                                        <span class=\"sign mobi-mbri mobi-mbri-plus mbr-iconfont\"></span>\n                                    </div>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text, .panel-body\">Agenti intelligenti che gestiscono conversazioni con empatia e precisione.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 1\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .icon-wrapper\">In quali settori operano?</h4>\n                                <div class=\"desc-wrapper\" mbr-if=\"showDesc\">\n                                    <p class=\"panel-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-desc\">Settori diversi, soluzioni personalizzate.</p>\n                                </div>\n                                <div class=\"icon-wrapper\">\n                                    <div class=\"icon-wrap\">\n                                        <span class=\"sign mobi-mbri mobi-mbri-plus mbr-iconfont\"></span>\n                                    </div>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text, .panel-body\">Finanza, assicurazioni, medicina, e molto altro ancora.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 2\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .icon-wrapper\">Come migliorano il servizio clienti?</h4>\n                                <div class=\"desc-wrapper\" mbr-if=\"showDesc\">\n                                    <p class=\"panel-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-desc\">Risposte rapide e assistenza continua.</p>\n                                </div>\n                                <div class=\"icon-wrapper\">\n                                    <div class=\"icon-wrap\">\n                                        <span class=\"sign mobi-mbri mobi-mbri-plus mbr-iconfont\"></span>\n                                    </div>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text, .panel-body\">Riduzione dei tempi di attesa e maggiore soddisfazione.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 3\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .icon-wrapper\">Quali vantaggi offrono?</h4>\n                                <div class=\"desc-wrapper\" mbr-if=\"showDesc\">\n                                    <p class=\"panel-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-desc\">Scopri i benefici dei nostri agenti.</p>\n                                </div>\n                                <div class=\"icon-wrapper\">\n                                    <div class=\"icon-wrap\">\n                                        <span class=\"sign mobi-mbri mobi-mbri-plus mbr-iconfont\"></span>\n                                    </div>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text, .panel-body\">Aumento delle vendite, risparmio di tempo e risorse.</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_name": "list02",
          "_sourceTheme": "soundm5",
          "_cid": "uBp6ZFdnuv",
          "_anchor": "faq-1-uBp6ZFdnuv",
          "alias": false,
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "if(@transparentBg, transparent, @bg-value)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".items-wrap": {
              "justify-content": "space-between"
            },
            ".content-wrapper": {
              "position": "relative",
              "display": "flex",
              "flex-wrap": "wrap",
              "padding": "96px",
              "overflow": "hidden",
              "@media (max-width: 1440px)": {
                "padding": "48px"
              },
              "@media (max-width: 992px)": {
                "padding": "26px 22px"
              },
              ".image-wrapper": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "object-fit": "cover",
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover"
                },
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "background-color": "@imageOver",
                  "opacity": "@imageOpacity",
                  "pointer-events": "none",
                  "z-index": "1"
                }
              },
              ".title-wrapper": {
                "position": "relative",
                "z-index": "2",
                "width": "50%",
                "margin-bottom": "60px",
                "padding-right": "32px",
                "@media (max-width: 992px)": {
                  "padding-right": "0",
                  "margin-bottom": "32px",
                  "width": "100%"
                },
                "& when (@reverseContent)": {
                  "padding-left": "32px",
                  "@media (max-width: 992px)": {
                    "padding-left": "0"
                  }
                },
                ".title-wrap": {
                  "display": "inline-flex",
                  "align-items": "center",
                  "@media (max-width: 1199px)": {
                    "display": "block"
                  },
                  ".logo-wrap": {
                    "img": {
                      "width": "86px",
                      "height": "86px",
                      "border-radius": "100% !important",
                      "object-fit": "cover"
                    },
                    "& when (@showTitle)": {
                      "margin-right": "68px",
                      "@media (max-width: 1440px)": {
                        "margin-right": "32px"
                      },
                      "@media (max-width: 1199px)": {
                        "margin-right": "0",
                        "margin-bottom": "22px"
                      }
                    }
                  },
                  ".mbr-section-title": {
                    "margin-bottom": "0"
                  }
                }
              },
              ".tabs-wrapper": {
                "position": "relative",
                "z-index": "2",
                "width": "50%",
                "margin-bottom": "60px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "32px",
                  "width": "100%"
                },
                ".nav.nav-tabs": {
                  "border": "1px solid @border",
                  "padding": "10px 16px",
                  "background-color": "@tabsBg",
                  "display": "inline-flex",
                  "justify-content": "center",
                  "flex-wrap": "wrap",
                  ".nav-item": {
                    "padding": "0",
                    "border": "none",
                    "display": "block",
                    "margin": "0",
                    ".nav-link": {
                      "color": "@tabs",
                      "padding": "12px 32px",
                      "border": "none",
                      "transition": "all 0.3s ease-in-out"
                    },
                    ".nav-link.active": {
                      "background-color": "@tabs",
                      "color": "@tabsBg"
                    }
                  }
                }
              },
              ".tab-content": {
                "position": "relative",
                "z-index": "2",
                "width": "100%",
                ".tab-pane": {
                  ".item-content": {
                    "display": "flex",
                    "align-items": "center",
                    "@media (max-width: 992px)": {
                      "display": "block"
                    },
                    ".image-wrap": {
                      "width": "50%",
                      "display": "flex",
                      "@media (max-width: 992px)": {
                        "width": "100%",
                        "margin-bottom": "32px"
                      },
                      "& when (@reverseContent)": {
                        "justify-content": "flex-end"
                      },
                      "img": {
                        "height": "650px",
                        "width": "650px",
                        "object-fit": "cover",
                        "border-radius": "100% !important",
                        "@media (max-width: 1600px)": {
                          "height": "550px",
                          "width": "550px"
                        },
                        "@media (max-width: 1440px)": {
                          "height": "450px",
                          "width": "450px"
                        },
                        "@media (max-width: 1200px)": {
                          "height": "350px",
                          "width": "350px"
                        },
                        "@media (max-width: 768px)": {
                          "height": "225px",
                          "width": "225px"
                        }
                      }
                    },
                    ".text-wrapper": {
                      "width": "50%",
                      "@media (max-width: 992px)": {
                        "width": "100%"
                      },
                      ".item-title": {
                        "margin-bottom": "32px"
                      },
                      ".item-text": {
                        "margin-bottom": "0"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#191c25"
            },
            ".item-title": {
              "color": "#000000"
            },
            ".item-text": {
              "color": "#000000"
            },
            ".tabs-wrapper": {
              "text-align": "right"
            },
            ".mbr-section-title, .title-wrapper, .tabs-wrapper": {
              "color": "#000000"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs tabs01 soundm5\" group=\"List\" plugins=\"mbr-tabs\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Image Overlay Color\" value=\"#FFF5E8\" name=\"imageOver\" selected>\n        <input type=\"range\" inline title=\"Image Overlay Opacity\" name=\"imageOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\">\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <input type=\"color\" title=\"Tabs Color\" value=\"#000000\" name=\"tabs\" selected>\n        <input type=\"color\" title=\"Tabs BG\" value=\"#FFF5E8\" name=\"tabsBg\" selected>\n        <input type=\"color\" title=\"Tabs Border Color\" value=\"#2EC4B6\" name=\"border\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#eeeef7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"image-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/photo-1531297484001-80022131f5a1.jpeg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n                            <div class=\"logo-wrap\" mbr-if=\"showLogo\">\n                                <img src=\"https://r.mobirisesite.com/1153980/assets/images/photo-1526666923127-b2970f64b422.jpeg\" alt=\"Mobirise\">\n                            </div>\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .title-wrapper, .tabs-wrapper\">Perché Sceglierci?</h2>\n                        </div>\n                    </div>\n                    <div class=\"tabs-wrapper\">\n                        <ul class=\"nav nav-tabs\" role=\"tablist\">\n                            <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item first mbr-fonts-style\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link show mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-4-uBp6ZFfL4G_tab0\" aria-selected=\"false\">Innovazione</a></li>\n                            <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-4-uBp6ZFfL4G_tab1\" aria-selected=\"false\">Affidabilità</a></li>\n                            <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-4-uBp6ZFfL4G_tab2\" aria-selected=\"true\">Efficacia</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"tab-content\">\n                        <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                            <div class=\"item-content\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/photo-1503437313881-503a91226402.jpeg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">Innovazione</h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\" mbr-if=\"showText\">I nostri agenti sono sempre aggiornati e pronti a rispondere alle tue esigenze, grazie a tecnologie all'avanguardia e modelli LLM avanzati.</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                            <div class=\"item-content\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/photo-1496096265110-f83ad7f96608.jpeg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">Affidabilità</h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\" mbr-if=\"showText\">Affidati a noi per un servizio clienti impeccabile, con assistenza continua e risposte rapide che faranno la differenza nel tuo business.</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                            <div class=\"item-content\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                <div class=\"image-wrap\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/photo-1488590528505-98d2b5aba04b.jpeg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">Efficacia</h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\" mbr-if=\"showText\">Con i nostri agenti, l'efficacia è garantita: vendite aumentate e clienti soddisfatti, il tutto con un tocco di empatia.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_name": "tabs01",
          "_sourceTheme": "soundm5",
          "_cid": "uBp6ZFfL4G",
          "_anchor": "features-4-uBp6ZFfL4G",
          "alias": false,
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "if(@transparentBg, transparent, @bg-value)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "60px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "32px"
                }
              }
            },
            ".items-wrap": {
              "justify-content": "center",
              "margin": "0 -46px",
              ".item": {
                "padding": "0 46px"
              }
            },
            ".item": {
              "margin-bottom": "32px",
              "&:hover, &:focus": {
                ".item-wrapper .item-img img": {
                  "transform": "scale(1.1)"
                }
              },
              ".item-wrapper": {
                ".item-price": {
                  "margin-bottom": "10px"
                },
                ".item-img": {
                  "margin-bottom": "22px",
                  ".image-wrapper": {
                    "overflow": "hidden",
                    "border": "3px solid @border",
                    "background-color": "@border",
                    "img": {
                      "height": "390px",
                      "width": "100%",
                      "object-fit": "cover",
                      "transition": "all 0.3s ease-in-out",
                      "@media (max-width: 992px)": {
                        "height": "350px"
                      }
                    }
                  }
                },
                ".item-content": {
                  ".item-title": {
                    "margin-bottom": "10px"
                  },
                  ".item-desc": {
                    "margin-bottom": "22px"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#191c25"
            },
            ".item-desc": {
              "color": "#000000",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#191c25",
              "text-align": "center"
            },
            ".item-title, .mbr-section-btn": {
              "text-align": "center",
              "color": "#000000"
            },
            ".item-price": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#000000",
              "text-align": "center"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing02 soundm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Name\" name=\"showName\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#2EC4B6\" name=\"border\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#eeeef7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .mbr-section-btn\"><b>AGENTI I.A. CONVERSAZIONALI</b></h2>\n                </div>\n            </div>\n        </div>\n        <div class=\"row items-wrap\">\n            <div class=\"col-12 col-lg-4 item features-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/photo-1496171367470-9ed9a91ea931.png\" alt=\"Mobirise Website Builder\">\n                        </div>\n                    </div>\n                    <div class=\"item-content\">\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">Pacchetto</h4>\n                        <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-price\">€3.497</p>\n                        <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-desc\" mbr-if=\"showDesc\">Agente conversazionale per assistenza clienti.</p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"index.html#contact-form-1-uBp6ZFnDvo\" data-app-placeholder=\"Type Text\">Chiedi info</a></div>\n                    </div>\n                </div>\n            </div><div class=\"col-12 col-lg-4 item features-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/photo-1488229297570-58520851e868.jpeg\" alt=\"Mobirise Website Builder\" data-slide-to=\"1\" data-bs-slide-to=\"2\">\n                        </div>\n                    </div>\n                    <div class=\"item-content\">\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">Pacchetto</h4>\n                        <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-price\">€4.997</p>\n                        <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-desc\" mbr-if=\"showDesc\">Agente conversazionale per vendite e lead generation.</p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"index.html#contact-form-1-uBp6ZFnDvo\" data-app-placeholder=\"Type Text\">Chiedi info</a></div>\n                    </div>\n                </div>\n            </div><div class=\"col-12 col-lg-4 item features-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/photo-1485827404703-89b55fcc595e.jpeg\" alt=\"Mobirise Website Builder\" data-slide-to=\"2\" data-bs-slide-to=\"3\">\n                        </div>\n                    </div>\n                    <div class=\"item-content\">\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">Pacchetto</h4>\n                        <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-price\">€6.899</p>\n                        <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-desc\" mbr-if=\"showDesc\">Soluzione completa per ogni settore.</p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"index.html#contact-form-1-uBp6ZFnDvo\" data-app-placeholder=\"Type Text\">Chiedi info</a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_name": "features03",
